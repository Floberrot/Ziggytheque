# Vite's hashed bundles (/assets/*) never change once built: a year, immutable.
# Everything else the SPA serves (index.html, icons) is revalidated on each load,
# so a deploy is picked up at once. Empty = no header: the backend's own
# Cache-Control stands on what nginx proxies.
map $uri $static_cache_control {
    ~^/assets/                   "public, max-age=31536000, immutable";
    ~^/(api|proxy|\.well-known)/ "";
    default                      "no-cache";
}

# The client's address. Railway's edge sets X-Real-IP on every request it forwards;
# without it (nginx reached directly, local run) the connecting address is the client.
# The backend reads it from X-Forwarded-For, believed only from the private network.
map $http_x_real_ip $client_ip {
    ""      $remote_addr;
    default $http_x_real_ip;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Not `always`: an error (a bundle 404) must never be cached for a year.
    add_header Cache-Control $static_cache_control;

    # The bundles are text: compress them (html is always compressed when on).
    # The backend compresses its own responses; nginx never compresses twice,
    # and the Mercure event stream (text/event-stream) is not in the list.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/json
               application/manifest+json image/svg+xml text/plain;

    # Baseline hardening. `always` so they are set on error responses too.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Cross-Origin-Opener-Policy same-origin always;
    # HSTS: Railway terminates TLS in front of nginx and serves www over HTTPS
    # only. No `preload`, and no includeSubDomains while other hosts exist.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Content Security Policy, REPORT-ONLY for now: the browser reports in its console
    # what the policy would block, and blocks nothing. Tuned for this SPA:
    #   script-src  'self'           Vite bundles and the PWA's registerSW.js, no inline script
    #   style-src   'unsafe-inline'  Vue style bindings, Tailwind / DaisyUI inline styles
    #   img-src     data: blob: https:  covers from any catalogue host, QR codes (data:)
    #   connect-src 'self'           /api and the Mercure EventSource, both proxied below
    #   media-src   blob:            the scanner's camera stream on older browsers
    #   worker-src / manifest-src    the vite-plugin-pwa service worker and manifest
    # To enforce it: check every page (scanner, charts, cover batch, install as an app)
    # shows no "Content-Security-Policy" report in the console, then rename the header
    # to Content-Security-Policy (and update the check in .github/workflows/docker.yml).
    # If MERCURE_PUBLIC_URL is ever on another origin, add it to connect-src first.
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

    # Public DNS resolver — 127.0.0.11 is Docker Compose only, not available on Railway
    resolver 8.8.8.8 8.8.4.4 valid=30s ipv6=off;

    # Proxy API and cover proxy calls to the backend service.
    # Using a variable forces nginx to re-resolve via the resolver above
    # rather than caching DNS at startup.
    location ~ ^/(api|proxy)/ {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;

        # Required when BACKEND_URL is an HTTPS URL: sends correct SNI and
        # skips certificate verification (inter-service on Railway, no need to verify).
        proxy_ssl_server_name on;
        proxy_ssl_verify     off;

        # Use the upstream host, not the frontend host, so the backend accepts the request.
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $client_ip;
        # Replaced, never appended: a client-sent X-Forwarded-For goes no further.
        proxy_set_header X-Forwarded-For   $client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Mercure SSE hub — proxied so the SPA's EventSource stays same-origin.
    # Buffering must be off or nginx would hold the stream and break live updates.
    location /.well-known/mercure {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;

        proxy_ssl_server_name on;
        proxy_ssl_verify     off;

        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $client_ip;
        # Replaced, never appended: a client-sent X-Forwarded-For goes no further.
        proxy_set_header X-Forwarded-For   $client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Server-Sent Events: forward chunks immediately and hold the connection open.
        proxy_set_header Connection '';
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        chunked_transfer_encoding off;
    }

    # A bundle missing after a deploy is a 404, not index.html served as script
    # (the SPA reloads itself on a failed chunk, see main.ts).
    location /assets/ {
        try_files $uri =404;
    }

    # SPA fallback: all unknown routes → index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
